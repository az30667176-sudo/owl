{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/az30667176-sudo/owl/packages/contract/record.schema.json",
  "title": "Contract A — record (ingest → process)",
  "description": "One unit of speaker-tagged text for the model to read in one go. Produced by services/ingest, consumed by services/process/extract.mjs.",
  "type": "object",
  "required": ["id", "content", "source", "hints"],
  "additionalProperties": false,
  "properties": {
    "_meta": { "$ref": "#/$defs/meta" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Stable, unique, URL-safe. Convention: rec-<YYYY-MM-DD>-<source-slug>." },
    "content": {
      "type": "string",
      "minLength": 50,
      "description": "Speaker-tagged text. Each turn starts on its own line as `<Rep. Full Name>: ...` (a name in people.json) or `<other>: ...`. Original wording must be preserved: quotes are validated as substrings of this field."
    },
    "source": {
      "type": "object",
      "required": ["url_link", "media_type", "media_name", "transcript"],
      "additionalProperties": false,
      "properties": {
        "url_link": { "type": "string", "format": "uri" },
        "media_type": { "enum": ["gov", "news"] },
        "media_name": { "type": "string", "pattern": "^[a-z0-9_-]+$", "description": "usgov, cspan, cnn, fox, ..." },
        "transcript": { "enum": ["official_transcript", "whisper", "muse_voice_transcribe"] }
      }
    },
    "hints": {
      "type": "object",
      "required": ["date"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date", "description": "Date of the statement(s), ISO YYYY-MM-DD." },
        "persons": { "type": "array", "items": { "type": "string" }, "description": "people.json ids expected in the text. Advisory only." },
        "bill_urls": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "mock": { "type": "boolean" },
        "contract_version": { "type": "string" }
      }
    }
  }
}
