{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/az30667176-sudo/owl/packages/contract/summaries.schema.json",
  "title": "Contract B — summaries.json (optional)",
  "description": "Per-legislator AI summaries generated offline. Every sentence cites >= 1 statement_id belonging to that legislator (checked by validate.mjs). Never generated at page load.",
  "type": "object",
  "required": ["summaries"],
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "allOf": [
        { "$ref": "record.schema.json#/$defs/meta" },
        { "type": "object", "properties": { "prompt_contract": { "type": "string" }, "generator": { "type": "string" } } }
      ]
    },
    "summaries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["model", "generated_at", "sentences"],
        "additionalProperties": false,
        "properties": {
          "model": { "type": "string" },
          "generated_at": { "type": "string", "format": "date" },
          "sentences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["text", "cites"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string", "minLength": 10, "maxLength": 400 },
                "cites": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^st[0-9]{3,}$" } }
              }
            }
          }
        }
      }
    }
  }
}
