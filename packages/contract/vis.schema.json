{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owl/contract/vis",
  "title": "VisPayload",
  "description": "Contract C: api -> web. Filtered graph for rendering.",
  "type": "object",
  "required": ["filter", "nodes", "edges"],
  "properties": {
    "filter": { "type": "object", "properties": { "state": { "type": "string" }, "domain": { "type": "string" }, "min_confidence": { "enum": ["low", "mid", "high", "super_high"] } } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["person", "bill", "domain"] },
          "name": { "type": "string" },
          "attrs": { "type": "array", "items": { "type": "object", "required": ["attr", "source"], "properties": { "attr": { "type": "string" }, "value": {}, "source": { "type": "string", "format": "uri" } } } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "direction", "linkage", "llm_confidence", "quote", "source"],
        "properties": {
          "from": { "type": "string" }, "to": { "type": "string" },
          "direction": { "enum": ["support", "oppose", "neutral"] },
          "linkage": { "enum": ["low", "mid", "high", "super_high"] },
          "llm_confidence": { "enum": ["low", "mid", "high", "super_high"] },
          "quote": { "type": "string" }, "source": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
