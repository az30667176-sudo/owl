{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owl/contract/preprocessed",
  "title": "PreprocessedRecord",
  "description": "Contract A: ingest -> process. One LLM-ingestable text unit.",
  "type": "object",
  "required": ["id", "content", "source"],
  "properties": {
    "id": { "type": "string" },
    "content": { "type": "string", "description": "Speaker-tagged text, e.g. <user>: ... / <other>: ..." },
    "source": {
      "type": "object",
      "required": ["url_link", "media_type", "media_name", "transcript"],
      "properties": {
        "url_link": { "type": "string", "format": "uri" },
        "media_type": { "enum": ["news", "gov"] },
        "media_name": { "type": "string" },
        "transcript": { "enum": ["whisper", "official_transcript"] }
      }
    },
    "hints": {
      "type": "object",
      "properties": {
        "persons": { "type": "array", "items": { "type": "string" } },
        "bill_urls": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string", "format": "date" }
      }
    }
  }
}
