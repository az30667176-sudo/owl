{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/az30667176-sudo/owl/packages/contract/taxonomy.schema.json",
  "title": "Contract B — taxonomy.json (levels 1 + 2)",
  "description": "House standing committees and their subcommittees. Source: congress.gov /committee/house.",
  "type": "object",
  "required": ["committees"],
  "additionalProperties": false,
  "properties": {
    "_meta": { "$ref": "record.schema.json#/$defs/meta" },
    "committees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "subcommittees"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^hs[a-z]{2}$", "description": "congress.gov House committee code, e.g. hsju." },
          "name": { "type": "string", "minLength": 1 },
          "subcommittees": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^hs[a-z]{2}-[a-z0-9-]+$", "description": "<committee id>-<slug>, e.g. hsju-crime." },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
