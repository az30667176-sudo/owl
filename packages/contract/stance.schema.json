{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owl/contract/stance",
  "title": "Stance",
  "description": "Contract B: process -> db/api. One (person, bill) edge with evidence.",
  "type": "object",
  "required": ["person", "bill", "direction", "linkage", "llm_confidence", "quote", "source_id"],
  "properties": {
    "person": { "type": "object", "required": ["name", "state"], "properties": { "name": { "type": "string" }, "state": { "type": "string", "minLength": 2, "maxLength": 2 } } },
    "bill": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" }, "title": { "type": "string" } } },
    "domain": { "type": "string", "description": "closed enum, see domains.json" },
    "action": { "type": "string", "description": "sponsor | cosponsor | vote_yea | vote_nay | speech | statement" },
    "direction": { "enum": ["support", "oppose", "neutral"] },
    "linkage": { "enum": ["low", "mid", "high", "super_high"] },
    "llm_confidence": { "enum": ["low", "mid", "high", "super_high"] },
    "quote": { "type": "string", "maxLength": 600, "description": "verbatim evidence" },
    "rationale": { "type": "string" },
    "source_id": { "type": "string" },
    "model": { "type": "string", "description": "e.g. muse-spark-1.3" }
  }
}
